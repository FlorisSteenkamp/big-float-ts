{
    "name": "big-float-ts",
    "sideEffects": false,
    "description": "An extended precision floating point library (as per Shewchuk) - precision only limited by overflow / underflow",
    "version": "4.0.4",
    "type": "module",
    "engines": {
        "node": "^12.20.0 || ^14.13.1 || >=16.0.0"
    },
    "author": {
        "name": "Floris Steenkamp"
    },
    "private": false,
    "license": "MIT",
    "main": "./node/index.js",
    "exports": "./node/index.js",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/FlorisSteenkamp/big-float.git"
    },
    "keywords": [
        "floating point",
        "infinite precision",
        "adaptive",
        "Shewchuk",
        "expansion"
    ],
    "bugs": {
        "url": "https://github.com/FlorisSteenkamp/big-float/issues"
    },
    "devDependencies": {
        "@jest/globals": "^30.5.2",
        "@swc/core": "^1.16.18",
        "@swc/jest": "^0.2.39",
        "@types/circular-dependency-plugin": "^5.0.8",
        "@types/jest": "^30.0.0",
        "@types/node": "^26.6.5",
        "@types/webpack-bundle-analyzer": "^4.7.0",
        "circular-dependency-plugin": "^5.2.2",
        "jest": "^30.5.2",
        "jest-cli": "^30.5.2",
        "jest-ts-webcompat-resolver": "^1.0.1",
        "rimraf": "^6.1.3",
        "squares-rng": "^2.0.4",
        "swc-loader": "^0.2.7",
        "typescript": "^7.0.2",
        "wabt": "^1.0.39",
        "wast-loader": "^1.14.1",
        "webpack": "^5.111.1",
        "webpack-bundle-analyzer": "^5.4.0",
        "webpack-cli": "^7.2.3"
    },
    "scripts": {
        "build": "npm run build-browser && npm run build-node",
        "build-node": "rimraf node && tsc",
        "build-browser": "rimraf browser && webpack",
        "test": "jest",
        "coverage": "jest --coverage",
        "test-package": "npm pack"
    },
    "allowScripts": {
        "@swc/core@1.16.18": true,
        "@parcel/watcher@2.6.0": true,
        "unrs-resolver@1.12.2": true
    }
}
